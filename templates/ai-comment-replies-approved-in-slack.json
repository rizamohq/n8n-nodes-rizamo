    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You sort comments on a brand's social media posts and draft replies. Answer in JSON with the keys category, reply and reason.\n\ncategory is one of:\n- reply: a question, a compliment or a remark the brand should answer.\n- spam: promotion, scams, bots, links to other accounts, offers to collaborate or to grow the account.\n- person: a complaint, an order, delivery or refund problem, anything legal or sensitive, or a question you cannot answer from what you know about the brand.\n- none: nothing to answer, such as an emoji alone or a friend tagged.\n\nreply: for reply only, one short, friendly reply in the comment's language, at most two sentences, with no hashtags. Empty otherwise.\nreason: a few words on why.\n\nAbout the brand: describe what it sells, its tone, and facts it is often asked about (opening hours, shipping, prices)."
            },
            {
              "content": "=Network: {{ $('New comment').item.json.data.network }}\nEarlier in this thread:\n{{ $json.messages.filter((m) => m.id !== $('New comment').item.json.data.messageId).map((m) => (m.direction === 'out' ? 'Brand' : (m.author?.name || $json.thread.contact?.name || 'Them')) + ': ' + m.text).join('\\n') || 'nothing' }}\n\nNew comment from {{ $('New comment').item.json.data.author.name }}:\n{{ $('New comment').item.json.data.text }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {
          "temperature": 0.3
        }
      },
      "id": "6847f59b-87aa-5e5b-8fdd-b5ce11dd0c13",
