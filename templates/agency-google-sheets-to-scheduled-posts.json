    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns Rizamo's result into the row's Status and Links.\nconst event = $('Post published or failed').item.json;\nconst name = (n) => ({ instagram: 'Instagram', facebook: 'Facebook', tiktok: 'TikTok', threads: 'Threads', youtube: 'YouTube', linkedin: 'LinkedIn' })[n] ?? n;\nconst live = event.data.published ?? [];\nconst failed = event.data.failed ?? [];\nconst why = (t) => t.status === 'unknown'\n  ? 'it may have gone out, check the network before publishing again'\n  : (typeof t.error === 'string' ? t.error : t.error?.message) || 'no reason given';\nconst problems = failed.map((t) => `${name(t.network)}: ${why(t)}`).join('; ');\nreturn {\n  json: {\n    row_number: $json.row_number,\n    Status: failed.length ? `${live.length ? 'Partly published' : 'Failed'}. ${problems}` : 'Published',\n    Links: live.map((t) => `${name(t.network)}: ${t.url}`).join('\\n'),\n    failed: failed.length > 0,\n    client: $json.Client,\n    summary: event.summary,\n  },\n};"
      },
      "id": "c9a7b124-5b82-58ed-9ed4-063e16ab51d4",
