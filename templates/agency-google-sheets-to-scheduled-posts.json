    {
      "parameters": {
        "jsCode": "// Finds each row's Rizamo profile by the client's name, and its accounts by the networks named.\nconst profiles = $('Get clients').all().map((i) => i.json);\nconst accounts = $('Get accounts').all().map((i) => i.json);\nconst clean = (s) => String(s ?? '').trim().toLowerCase();\n\nreturn $('Ready').all().map((row) => {\n  const r = row.json;\n  const profile = profiles.find((p) => clean(p.name) === clean(r.Client));\n  const wanted = String(r.Networks ?? '').split(',').map((s) => s.trim()).filter(Boolean);\n  const theirs = profile ? accounts.filter((a) => a.profileId === profile.id) : [];\n  const picked = wanted.length ? theirs.filter((a) => wanted.some((n) => clean(n) === a.network)) : theirs;\n  const missing = wanted.filter((n) => !theirs.some((a) => a.network === clean(n)));\n  let problem = '';\n  if (!profile) problem = `no Rizamo profile is named \"${r.Client}\"`;\n  else if (missing.length) problem = `${profile.name} has no ${missing.join(', ')} account in Rizamo`;\n  else if (!picked.length) problem = `${profile.name} has no accounts in Rizamo`;\n  return {\n    json: {\n      row_number: r.row_number,\n      profileId: profile?.id ?? '',\n      accountIds: picked.map((a) => a.id),\n      text: r.Text ?? '',\n      mediaUrls: r['Media URLs'] ?? '',\n      publishAt: String(r['Publish at'] ?? '').trim().replace(' ', 'T'),\n      problem,\n    },\n  };\n});"
      },
